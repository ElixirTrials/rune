        {"repo": "spring-projects/spring-boot", "language": "java", "paradigm": "oop/enterprise"},
        {"repo": "google/guava", "language": "java", "paradigm": "oop/algorithms"},
        {"repo": "TheAlgorithms/Java", "language": "java", "paradigm": "algorithms"},

        {"repo": "rails/rails", "language": "ruby", "paradigm": "oop/web"},
        {"repo": "ruby/ruby", "language": "ruby", "paradigm": "systems/oop"},

        {"repo": "jqlang/jq", "language": "c", "paradigm": "systems/fp"},
        {"repo": "redis/redis", "language": "c", "paradigm": "systems/data-structures"},

        {"repo": "typelevel/cats", "language": "scala", "paradigm": "fp/typeclasses"},
        {"repo": "elixir-lang/elixir", "language": "elixir", "paradigm": "fp/concurrent"},
        {"repo": "hasura/graphql-engine", "language": "haskell", "paradigm": "fp/web"}
