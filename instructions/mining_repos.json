{
    "description": "Phase 1 Bootstrap: 25 repos across 10 languages covering OOP, FP, systems, algorithms",
    "defaults": {
        "max_prs": 200,
        "quality": true,
        "min_review_comments": 1,
        "min_commits": 2
    },
    "repos": [
        {"repo": "huggingface/transformers", "language": "python", "paradigm": "oop/ml"},
        {"repo": "scikit-learn/scikit-learn", "language": "python", "paradigm": "oop/ml"},
        {"repo": "fastapi/fastapi", "language": "python", "paradigm": "web/async"},
        {"repo": "apache/airflow", "language": "python", "paradigm": "oop/infra"},
        {"repo": "python/cpython", "language": "python", "paradigm": "systems/stdlib"},
        {"repo": "pytorch/pytorch", "language": "python", "paradigm": "oop/ml"},
        {"repo": "TheAlgorithms/Python", "language": "python", "paradigm": "algorithms"},

        {"repo": "microsoft/TypeScript", "language": "typescript", "paradigm": "compiler/oop"},
        {"repo": "vercel/next.js", "language": "javascript", "paradigm": "web/framework"},

        {"repo": "denoland/deno", "language": "rust", "paradigm": "systems/async"},
        {"repo": "rust-lang/rust-analyzer", "language": "rust", "paradigm": "compiler/fp-oop"},

        {"repo": "cliutils/CLI11", "language": "cpp", "paradigm": "oop/library"},
